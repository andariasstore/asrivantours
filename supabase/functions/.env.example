# Set these only in Supabase Edge Function Secrets or local supabase/functions/.env.
# Never commit real values.
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_DEFAULT_PAYMENT_TYPE=
# JSON object merged into Midtrans /v2/charge request for the selected payment_type.
# Example for a merchant-enabled bank transfer: {"bank_transfer":{"bank":"bca"}}
MIDTRANS_CHANNEL_CONFIG_JSON={}
# Quote lifetime and booking access token lifetime.
ASRIVA_QUOTE_TTL_SECONDS=600
ASRIVA_BOOKING_ACCESS_TTL_SECONDS=86400
